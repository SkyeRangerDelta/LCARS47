# ===================================
# LCARS47 Environment Configuration
# ===================================
# Copy this file to .env and fill in your values
# See Src/Subsystems/Auxiliary/ENVChecks.json for detailed descriptions

# -----------------------------------
# CRITICAL - Bot cannot start without these
# -----------------------------------
TOKEN=your_discord_bot_token
RDS=mongodb://your_connection_string
PLDYNID=your_discord_guild_id
LCARSID=your_bot_user_id

# -----------------------------------
# REQUIRED - Core features need these
# -----------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key
MEDIALOG=channel_id_for_media_logging
ENGINEERING=channel_id_for_engineering_logs
SIMLAB=channel_id_for_simlab_ai
DEVLAB=channel_id_for_devlab_ai

# -----------------------------------
# OPTIONAL - API server (has defaults)
# -----------------------------------
# API_HOST=localhost
# API_PORT=9121

# -----------------------------------
# OPTIONAL - JWST integration
# -----------------------------------
# JWST=your_jwst_api_key

# -----------------------------------
# OPTIONAL - Beszel server monitoring
# All three required if using Beszel
# -----------------------------------
# BESZEL_URL=https://your-beszel-instance.com
# BESZEL_EMAIL=admin@example.com
# BESZEL_PASSWORD=your_beszel_password
# Channel for system up/down alerts. Falls back to ENGINEERING when unset.
# BESZEL_ALERT_CHANNEL=channel_id_for_system_alerts

# -----------------------------------
# OPTIONAL - CubeCoders AMP game server control
# All three required if using AMP
# -----------------------------------
# Use a dedicated AMP API user granted only Core.AppManagement.StartApplication
# and Core.AppManagement.StopApplication on the instances it should control.
# Two-factor authentication is not supported on this account.
# AMP_URL=https://amp.pldyn.net
# AMP_USERNAME=lcars47
# AMP_PASSWORD=your_amp_api_user_password
# Channel for the control-action audit trail. Falls back to ENGINEERING.
# AMP_AUDIT_CHANNEL=channel_id_for_amp_audit
# Channel for game server crash alerts. Falls back to ENGINEERING.
# AMP_ALERT_CHANNEL=channel_id_for_amp_alerts

# -----------------------------------
# OPTIONAL - Jellyfin media server
# All five required if using Jellyfin
# -----------------------------------
# JELLYFIN_HOST=localhost
# JELLYFIN_PORT=8096
# JELLYFIN_KEY=your_jellyfin_api_key
# JELLYFIN_USER=your_jellyfin_username
# JELLYFIN_PASS=your_jellyfin_password
# Translates server-side paths to container paths so streaming reads files
# directly from the NAS mount instead of via Jellyfin HTTP transcode.
# Format: from=>to,from2=>to2
# JELLYFIN_PATH_MAP=/media/music=>/mnt/nas/music

# -----------------------------------
# OPTIONAL - /computer slash command cooldown (seconds, per user)
# -----------------------------------
# COMPUTER_CMD_COOLDOWN_SEC=60

# -----------------------------------
# OPTIONAL - Admin command allowlist
# -----------------------------------
# Comma-separated Discord user IDs allowed to run /ytdlp-update, /amp
# start|stop and other admin slash commands. Falls back to the Discord guild
# Administrator permission when unset.
# ADMIN_USER_IDS=111111111111111111,222222222222222222

# -----------------------------------
# OPTIONAL - Ship navigation
# -----------------------------------
# Channel ID for arrival announcements from /move. Falls back to ENGINEERING
# when unset.
# SHIP_LOG_CHANNEL=333333333333333333

# -----------------------------------
# OPTIONAL - Astrometrics
# -----------------------------------
# Set to false to stop the bot querying the SIMBAD and STAPI catalogues.
# /astrometrics then reports procedural sensor readings only. Defaults to true.
# ASTROMETRICS_REMOTE=true
